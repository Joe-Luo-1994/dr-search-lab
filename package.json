{
  "name": "dr-search-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "prepare:data": "node scripts/prepare.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "benchmark": "node --env-file-if-exists=.env.local scripts/benchmark.mjs",
    "observe": "node --env-file-if-exists=.env.local scripts/observe.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "experiment:es": "node scripts/es-experiment.mjs",
    "experiment:release": "node --env-file-if-exists=.env.local scripts/readonly-release-experiment.mjs",
    "provision": "node --env-file-if-exists=.env.local scripts/provision.mjs",
    "cloud:preflight": "node scripts/cloud-preflight.mjs",
    "transfer:export": "node scripts/export-transfer.mjs",
    "es:control": "node scripts/es-control.mjs"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "minisearch": "7.2.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
